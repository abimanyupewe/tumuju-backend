PORT=3000
NODE_ENV=development

# Database Connections (Neon PostgreSQL / Serverless)
# 1. DATABASE_URL: Menggunakan Connection Pooling (PgBouncer, port 6543)
#    Dipakai oleh NestJS runtime untuk efisiensi koneksi tinggi tanpa exhaustion.
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/tumuju_db?sslmode=require&pgbouncer=true"

# 2. DIRECT_URL: Direct Connection / Non-Pooling (Port 5432)
#    Wajib untuk Prisma CLI (prisma migrate dev / deploy) karena PgBouncer tidak mendukung session advisory lock.
DIRECT_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/tumuju_db?sslmode=require"

# NestJS Observe (Distributed Tracing & Metrics)
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET

# Firebase Admin SDK (Opsional / Fase Autentikasi)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
